# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings → API, or the "Connect" button on the project page).
# These two values are safe to use in the browser. Never put the service_role /
# secret key or the Gemini API key here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_KEY=your-anon-or-publishable-key
